{
  "name": "relax-tug",
  "version": "0.1.0",
  "private": true,
  "description": "解压拔河大作战（RelaxTug — Color Battle）· 抖音小游戏 —— 1v1 实时拔河色块对战",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "gen": "node tools/gen-constants.js && node tools/gen-cloud-functions.js",
    "gen:check": "node tools/gen-constants.js --check && node tools/gen-cloud-functions.js --check",
    "sim": "node tools/sim-balance.js",
    "sim:check": "node tools/sim-balance.js --check",
    "sim:levels": "node tools/sim-levels.js --baseline",
    "sim:levels:check": "node tools/sim-levels.js --check",
    "verify": "npm test && npm run gen:check && npm run sim:check && npm run sim:levels:check"
  }
}
